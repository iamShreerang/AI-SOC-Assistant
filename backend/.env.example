# ========================================
# AI SOC Assistant - Environment Variables
# ========================================
# Copy this file to .env and update with your actual values
# WARNING: Never commit .env to Git!

# Application
APP_NAME=AI SOC Assistant
DEBUG=false

# JWT Authentication
# REQUIRED: Generate a secure secret key using:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Example: openssl rand -hex 32
SECRET_KEY=CHANGE-ME-GENERATE-SECURE-KEY-HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_SECRET_KEY=CHANGE-ME-GENERATE-ANOTHER-SECURE-KEY-HERE

# Database
# REQUIRED: PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://soc_user:CHANGE_PASSWORD@localhost:5432/soc_db

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_RAW_LOGS=raw-logs

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# LLM - Groq API (Free Tier)
# Get your free API key from: https://console.groq.com/keys
# Free tier: 14,400 requests/day (Llama 3.1 70B)
GROQ_API_KEY=

# OAuth2 - Google
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth2 - GitHub
# Get credentials from: https://github.com/settings/applications/new
# Authorization callback URL: http://localhost:8000/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
