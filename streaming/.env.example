# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_INPUT_TOPIC=unsw-logs
KAFKA_OUTPUT_TOPIC=predictions

# Spark
SPARK_MASTER=local[*]
SPARK_APP_NAME=AI-SOC-Streaming

# ML
MODEL_DIR=ml/saved_models
PIPELINE_DIR=ml/saved_models

# Streaming behaviour
BATCH_INTERVAL_SECS=5
SEQUENCE_LENGTH=10
PRODUCER_DELAY_SECS=0.5

# Backend API integration
BACKEND_API_URL=http://localhost:8000
BACKEND_API_TIMEOUT_SECS=5
METRICS_PUBLISH_SECS=15

# Spark checkpoint (Linux/Docker default; override on native Windows, e.g. C:/tmp/soc-checkpoint)
SPARK_CHECKPOINT_DIR=/tmp/soc-checkpoint

# Threat detection rule thresholds
REPEAT_ATTACK_THRESHOLD=3
REPEAT_ATTACK_WINDOW_SECS=60
HIGH_RATE_THRESHOLD_PER_SEC=20
LARGE_TRANSFER_BYTES=1000000
PORT_SCAN_DISTINCT_PORTS=6
PORT_SCAN_WINDOW_SECS=60
